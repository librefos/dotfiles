[user]
	name = Thiago C. Silva
	email = librefos@newliber.com
	signingkey = 74DB0F2861858C96D636C0BC1DCAB8FD50D746A9
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[sendemail]
	sendmailcmd = ssh-sendmail
	transferEncoding = 8bit
	assume8bitEncoding = UTF-8
	confirm = always
	annotate = yes
