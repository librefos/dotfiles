set nocompatible

filetype plugin on
runtime! ftplugin/man.vim

syntax enable

packadd netrw
set path+=**
set wildmenu

let g:netrw_banner=0
let g:netrw_browse_split=4
let g:netrw_altv=1
let g:netrw_liststyle=3
let g:netrw_list_hide = netrw_gitignore#Hide() .. '.*\.swp$'
let g:netrw_list_hide .= ',\(^\|\s\s\)\zs\.\S\+'
let g:netrw_browsex_viewer = 'firefox-devedition'

set undofile undodir=~/.vim/undodir

set cursorline nowrap background=dark colorcolumn=73
set expandtab textwidth=72 shiftwidth=4 tabstop=8 softtabstop=4 smarttab

colorscheme quiet
