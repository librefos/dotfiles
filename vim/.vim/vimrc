unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim
filetype plugin indent on
runtime ftplugin/man.vim

let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_list_hide = '.*\.swp$'
let g:netrw_browsex_viewer = 'firefox-devedition'

augroup SetIndentation
  autocmd!
  autocmd FileType c,cpp setlocal et sw=2 sts=2 ts=8 tw=79 cc=80 cin
  autocmd FileType python,php,java setlocal et sw=4 sts=4 ts=8 tw=79 cc=80
  autocmd FileType sh,javascript,html,tex setlocal et sw=2 sts=2 ts=8 tw=79 cc=80
augroup END

autocmd FocusGained,BufEnter * checktime

set nocompatible encoding=utf-8 cursorline background=dark
set nowrap ignorecase smartcase incsearch undofile undodir=~/.vim/undodir
colorscheme quiet
function! s:QuietDiffColors() abort
  hi DiffAdd    cterm=NONE ctermfg=15 ctermbg=NONE
  hi DiffDelete cterm=NONE ctermfg=8 ctermbg=NONE
  hi DiffChange cterm=NONE ctermfg=NONE ctermbg=NONE
  hi DiffText   cterm=NONE ctermfg=6 ctermbg=NONE
endfunction
autocmd ColorScheme * call s:QuietDiffColors()
call s:QuietDiffColors()

set diffopt+=algorithm:histogram,indent-heuristic
try
  set diffopt+=inline:word
catch
endtry
