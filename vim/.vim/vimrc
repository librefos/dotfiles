source $VIMRUNTIME/defaults.vim
runtime ftplugin/man.vim

let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_list_hide = '.*\.swp$'
let g:netrw_browsex_viewer = 'firefox-devedition'

augroup SetIndentation
  autocmd!
  autocmd FileType c,cpp setlocal ts=8 cin
  autocmd FileType python,php,java setlocal sw=4 sts=4 ts=4
augroup END

autocmd FocusGained,BufEnter * checktime

set ar cul nowrap bg=dark ic scs udf udir=~/.vim/undodir et sw=2 sts=2
set ts=2 tw=79 cc=80 diffopt+=algorithm:histogram,indent-heuristic
set dip+=inline:word
colo quiet
