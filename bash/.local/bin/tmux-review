# along with this program.  If not, see <https://www.gnu.org/licenses/>.

# Every error path pauses with `read` because the tmux popup closes
# as soon as the script exits, hiding the message.
git rev-parse --git-dir >/dev/null 2>&1 ||
  { printf 'Not a git repo\n' >&2; read -rn1; exit 1; }

toplevel="$(git rev-parse --show-toplevel)" ||
  { printf 'Cannot find repo root\n' >&2; read -rn1; exit 1; }
readonly toplevel

cd "$toplevel" ||
  { printf 'Cannot enter %s\n' "$toplevel" >&2; read -rn1; exit 1; }

# git diff ignores untracked files; marking them intent-to-add (-N)
# makes new files show up in the review without staging content.
mapfile -t untracked_files < <(git ls-files --others --exclude-standard)
readonly untracked_files
if [ "${#untracked_files[@]}" -gt 0 ]; then
  printf 'New file: %s\n' "${untracked_files[@]}"
  read -rp 'Include new files in review? [Y/n] ' -n1 answer
  printf '\n'
  [[ "$answer" == [nN] ]] || git add -N -- "${untracked_files[@]}"
fi

mapfile -t changed_files < <(git diff --name-only)
readonly changed_files
[ "${#changed_files[@]}" -gt 0 ] || printf 'No unstaged changes\n'

readonly total_files="${#changed_files[@]}"
position=0
for file in "${changed_files[@]}"; do
  position="$((position + 1))"
  git diff --quiet -- "$file" && continue
  printf '[%s/%s] %s\n' "$position" "$total_files" "$file"
  git difftool -y -- "$file" || exit 0
  git add -p -- "$file"
  if ! git diff --cached --quiet; then
    read -rp 'Commit staged changes now? [y/N] ' -n1 answer; printf '\n'
    [[ "$answer" == [yY] ]] && git commit -S -s
  fi
done

if ! git diff --cached --quiet; then
  read -rp 'Commit remaining staged changes? [y/N] ' -n1 answer
  printf '\n'
  [[ "$answer" == [yY] ]] && git commit -S -s
fi
read -rp 'Done. Press a key' -n1
